general:
  bootstrap_end_time: 300
  progress: true
  stop_time: 3600
  template_directory: shadow.data.template
hosts:
  4uthority1:
    bandwidth_down: 1000000 kilobit
    bandwidth_up: 1000000 kilobit
    ip_addr: 100.0.0.1
    network_node_id: 327
    processes:
    - args: --Address 4uthority1 --Nickname 4uthority1 --defaults-torrc torrc-defaults
        -f torrc
      expected_final_state: running
      path: ~/.local/bin/tor
      start_time: 1
    - args: Mode=log TorControlPort=9051 LogLevel=info Events=BW,CIRC,CIRC_BW
      expected_final_state: running
      path: ~/.local/bin/oniontrace
      start_time: 2
  4uthority2:
    bandwidth_down: 1000000 kilobit
    bandwidth_up: 1000000 kilobit
    ip_addr: 100.0.0.2
